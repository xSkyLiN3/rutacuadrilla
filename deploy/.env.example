# Copiar como deploy/.env en el host. El nombre no lleva esquema, puerto ni ruta.
APP_HOST=app.example.com
EDGE_HTTP_PORT=8432

# Identificador inmutable por despliegue.
APP_RELEASE=0.1.0

SESSION_TTL_MINUTES=480

# Identidad pública del bootstrap inicial. La contraseña va solo en
# deploy/secrets/initial_admin_password y se elimina tras aprovisionar.
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_DISPLAY_NAME=Administración inicial
INITIAL_CREW_NAME=Cuadrilla inicial
INITIAL_CREW_SLUG=cuadrilla-inicial
