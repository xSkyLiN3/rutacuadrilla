# Entorno local de demostración. Estas credenciales son públicas y no deben
# reutilizarse ni desplegarse en Internet.
NODE_ENV=development
APP_PROFILE=simple
API_HOST=127.0.0.1
API_PORT=4310
TRUST_PROXY=0
DATABASE_DIR=.local/demo-db
SESSION_SECRET=local-demo-only-session-secret-32-characters-minimum
SESSION_TTL_MINUTES=480
CORS_ORIGIN=http://127.0.0.1:4311,http://localhost:4311,http://127.0.0.1:4312,http://localhost:4312
VITE_API_URL=
VITE_MAP_STYLE_URL=
VITE_DEMO_MODE=true
DEMO_ADMIN_PASSWORD=LocalDemoAdmin-2026!
DEMO_MEMBER_PASSWORD=LocalDemoField-2026!
DEMO_OUTSIDER_PASSWORD=LocalDemoOutside-2026!
