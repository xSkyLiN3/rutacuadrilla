# API local. Copiar a .env y reemplazar todos los valores de ejemplo.
NODE_ENV=development
APP_PROFILE=simple
API_HOST=127.0.0.1
API_PORT=4310
TRUST_PROXY=0

# PostgreSQL local. `npm run local:postgres:setup` genera esta URL con una
# contraseña aleatoria y deja el servidor escuchando solo en 127.0.0.1:55432.
DATABASE_URL=postgresql://rutacuadrilla:replace-local-password@127.0.0.1:55432/rutacuadrilla

# Obligatorio: mínimo 32 caracteres aleatorios. El valor de ejemplo no debe usarse fuera de local.
SESSION_SECRET=replace-with-at-least-32-random-characters
# En el piloto VPS se usa SESSION_SECRET_FILE en lugar de SESSION_SECRET; nunca ambas.
# SESSION_SECRET_FILE=/run/secrets/session_secret
SESSION_TTL_MINUTES=480

# Orígenes exactos permitidos, separados por coma: consola y cliente de campo local.
CORS_ORIGIN=http://127.0.0.1:4311,http://localhost:4311,http://127.0.0.1:4312,http://localhost:4312
# Vacío usa el proxy /api de Vite y permite abrir Campo desde otro equipo de la red local.
VITE_API_URL=
VITE_MAP_STYLE_URL=
VITE_DEMO_MODE=false

# Seed local explícito. Estas cuentas usan datos ficticios; define las contraseñas solo en tu .env.
# Usuarios fijos: admin@demo.rutacuadrilla.local, miembro@demo.rutacuadrilla.local
# y externo@demo.rutacuadrilla.local. Solo el password de admin habilita el seed.
DEMO_ADMIN_PASSWORD=
DEMO_MEMBER_PASSWORD=
DEMO_OUTSIDER_PASSWORD=
